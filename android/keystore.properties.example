# Copy to android/keystore.properties and fill in. That file, and any .jks, are
# git ignored — signing material must never reach the repo.
#
# Create the key from the android/app directory:
#
#   cd android/app
#   keytool -genkeypair -v -keystore upload.jks -alias upload \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# keytool asks for the passwords; nobody else needs to see them. A relative
# storeFile below is resolved against android/app, which is where the command
# above puts it. An absolute path works too.
#
# Back up upload.jks and the passwords somewhere off this machine. Losing them
# means the app can never be updated on the Play Store under this listing —
# Google cannot reset an upload key you generated yourself without a support
# request, and recovery is not guaranteed.

storeFile=upload.jks
storePassword=
keyAlias=upload
keyPassword=
